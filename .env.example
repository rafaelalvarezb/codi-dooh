# Copy this file to .env.local and fill in your Pey API key.
# Get a key at: https://portal.mipey.mx
# Docs: https://docs.pey.mx

PEY_API_KEY=sk_live_your_key_here
PEY_API_BASE_URL=https://api.pey.mx

# Optional: webhook signing secret from Pey portal (Standard Webhooks)
# PEY_WEBHOOK_SECRET=whsec_your_secret_here

# Optional: push bridge for bathroom relay / barrier pulse
# Example: http://192.168.1.50:8787  (Pi/ESP32 agent exposing POST /pulse)
# If unset, pulses are queued for ESP32 poll at GET /api/relay/events
# and logged as simulated.
# RELAY_BRIDGE_URL=http://127.0.0.1:8787

# Portal /portal login (defaults: admin@codidooh.mx / codidooh)
PORTAL_ADMIN_EMAIL=admin@codidooh.mx
PORTAL_ADMIN_PASSWORD=codidooh
PORTAL_SECRET=change-me-to-a-long-random-string
