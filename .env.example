# Copy this file to .env.local for local development.
# Everything is optional locally: without DATABASE_URL the app uses an
# in-process Postgres (PGlite) saved in .data/, and without
# BLOB_READ_WRITE_TOKEN uploaded videos are saved in .data/uploads.

# ── CoDi / Pey ────────────────────────────────────────────────
# Get a key at https://portal.mipey.mx · Docs: https://docs.pey.mx
# Without a real key the kiosk shows a mock QR (never confirms).
PEY_API_KEY=sk_live_your_key_here
PEY_API_BASE_URL=https://api.pey.mx
# Webhook signing secret from the Pey portal (Standard Webhooks).
# With it, /api/codi/webhook only accepts correctly signed calls. Without it,
# every payment notice is double-checked against Pey's API before it counts.
# PEY_WEBHOOK_SECRET=whsec_your_secret_here

# ── Database (Neon Postgres via Vercel Marketplace) ───────────
# Added automatically when you connect Neon to the Vercel project.
# Migrations run before `next build` when this is set.
# DATABASE_URL=postgres://user:password@host/db?sslmode=require

# ── Video storage (Vercel Blob) ───────────────────────────────
# Added automatically when you connect a Blob store to the project.
# Either a read-write token…
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx
# …or, for OIDC stores (no token), the store id; Vercel injects
# VERCEL_OIDC_TOKEN at runtime.
# BLOB_STORE_ID=store_xxx

# ── Sessions and kiosk tokens ─────────────────────────────────
# Long random string (32+ chars). Signs login cookies and derives each
# screen's kiosk token. Changing it logs everyone out and invalidates
# every kiosk URL.
SESSION_SECRET=change-me-to-a-long-random-string

# ── Platform admin (bootstrapped as a user with isPlatformAdmin) ──
# Use a strong password in production; the defaults are public.
PORTAL_ADMIN_EMAIL=admin@codidooh.mx
PORTAL_ADMIN_PASSWORD=codidooh

# Optional: password for the demo accounts created by `npm run db:seed`
# (host@demo.codidooh.mx, silvertag@demo.codidooh.mx). If unset they get a
# random password and the admin uses "Operar como" instead.
# DEMO_USER_PASSWORD=

# ── Money defaults (admin can change them in /admin/ajustes) ──
# Platform commission in basis points (3000 = 30% platform / 70% host).
PLATFORM_COMMISSION_BPS=3000
# Price per spot per screen per month, in MXN.
DEFAULT_SPOT_PRICE_MXN=1000
# Day of the month hosts get paid.
PAYOUT_DAY=5

# ── Relay bridge (bathroom lock / barrier) ────────────────────
# Example: http://192.168.1.50:8787 (Pi/ESP32 agent exposing POST /pulse).
# If unset, pulses are queued for ESP32 poll at GET /api/relay/events
# and logged as simulated (in-memory — broken across Vercel instances).
# RELAY_BRIDGE_URL=http://127.0.0.1:8787

# Upstash Redis REST (free tier) — required for ESP32 ↔ Vercel production
# Create at https://console.upstash.com → Redis → REST API
# Then add the same two names in Vercel → Project → Settings → Environment Variables
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=AXxxxx

# ── Domains ───────────────────────────────────────────────────
# cobten.com shows the landing; app paths there redirect to this URL.
# Default: https://app.cobten.com
# NEXT_PUBLIC_APP_URL=https://app.cobten.com
